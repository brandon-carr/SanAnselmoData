# --- ETRAKIT AUTH ---
ETRAKIT_USERNAME=your_username
ETRAKIT_PASSWORD=your_password

# --- DATE LOGIC ---
DAYS_BACK=1
FORCE_RERUN=false

# --- DEBUG ---
ETRAKIT_DEBUG=true
ETRAKIT_DEBUG_DIR=data/debug

# --- URLS ---
ETRAKIT_BASE_URL=https://sanan-trk.aspgov.com/eTRAKiT/
ETRAKIT_LOGIN_URL=https://sanan-trk.aspgov.com/eTRAKiT/
ETRAKIT_PERMIT_SEARCH_URL=https://sanan-trk.aspgov.com/eTRAKiT/Search/Permit.aspx

# --- FORM FIELDS (override if needed) ---
ETRAKIT_USERNAME_FIELD=ctl00$MainContent$txtUserName
ETRAKIT_PASSWORD_FIELD=ctl00$MainContent$txtPassword
ETRAKIT_LOGIN_BUTTON_FIELD=ctl00$MainContent$btnLogin
ETRAKIT_SEARCH_BY_FIELD=ctl00$MainContent$ddlSearchBy
ETRAKIT_ISSUED_START_FIELD=ctl00$MainContent$txtStartDate
ETRAKIT_ISSUED_END_FIELD=ctl00$MainContent$txtEndDate
ETRAKIT_SEARCH_BUTTON_FIELD=ctl00$MainContent$btnSearch
ETRAKIT_ISSUED_SEARCH_VALUE=ISSUED
